# Copy to .env and fill in. Never commit .env.

# Required
MEM_DB_PASSWORD=change-me                 # openssl rand -hex 16

# Embeddings (local, no external calls). Changing the model requires a re-embed.
MEM_EMBED_MODEL=intfloat/multilingual-e5-small
MEM_EMBED_DIM=384

# Language of MCP tool descriptions shown to agents: en (default) | ru
# MEM_MCP_LANG=en

# Time zone of the sleep schedule (light sleep daily at 03:30, deep sleep Sundays at 04:00)
# MEM_TZ=UTC

# Admin token for localhost-only admin API (optional; the CLI does not need it)
# MEM_ADMIN_TOKEN=
# Secret path segment for /status (optional)
# MEM_STATUS_SECRET=

# Alerts: any JSON webhook that accepts {"text": "..."} (Slack, Mattermost, your own), and/or Telegram
# MEM_ALERT_WEBHOOK_URL=
# MEM_TG_BOT_TOKEN=
# MEM_TG_CHAT_ID=
# MEM_TG_PROXY=socks5://host:port   # Telegram through a SOCKS5 proxy

# Deep sleep models (optional, no default). Without them the model stages are DISABLED and only deterministic steps run.
# Anthropic:            MEM_ANTHROPIC_API_KEY=...
#                       MEM_DEEP_MODEL_REASON=claude-sonnet-5
#                       MEM_DEEP_MODEL_SUMMARY=claude-haiku-4-5-20251001
# OpenAI-compatible model inside your perimeter:
# MEM_OPENAI_BASE_URL=http://llm.internal:8000/v1
# MEM_OPENAI_API_KEY=
# MEM_OPENAI_IN_CONTOUR_MODELS=my-model
# MEM_DEEP_MODEL_REASON=openai:my-model
# MEM_DEEP_MODEL_SUMMARY=openai:my-model
